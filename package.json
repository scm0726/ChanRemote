{
  "name": "chanremote",
  "productName": "ChanRemote",
  "version": "1.4.0",
  "description": "나만의 원격 제어 프로그램 (PC↔PC, PC↔모바일) — 무설치",
  "main": "src/main.js",
  "author": "chanmin",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win portable"
  },
  "dependencies": {
    "koffi": "^2.9.0",
    "qrcode": "^1.5.4",
    "ws": "^8.18.0",
    "mqtt": "^5.10.0"
  },
  "devDependencies": {
    "electron": "^38.0.0",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "com.chanmin.chanremote",
    "productName": "ChanRemote",
    "asar": false,
    "files": [
      "src/**/*",
      "web/**/*",
      "assets/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "portable"
      ],
      "icon": "assets/icon.ico",
      "requestedExecutionLevel": "asInvoker"
    },
    "portable": {
      "artifactName": "ChanRemote-${version}.${ext}",
      "requestExecutionLevel": "user",
      "unicode": true
    },
    "publish": null
  }
}
